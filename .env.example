# Port for backend proxy
PORT=3001

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: Groq API Key (Fast LLaMA inference at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional: OpenAI API Key (at https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
